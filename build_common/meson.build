# ── Shared compositor build fragment (single source of truth) ─────────────────
# Included via subdir() by BOTH:
#   • build/meson.build            (root → the `freebsdx` target, drives out/)   → subdir('core/xserver/build_common')
#   • core/xserver/meson.build     (standalone → the `xserver` target)           → subdir('build_common')
#
# It defines the compositor's drift-prone lists exactly once — the source groups,
# the compositor/xrender shaders, and the Wayland-protocol generation — so adding
# a compositor source / shader / protocol is a ONE-file edit here, not two.
# files()/custom_target() objects carry their own anchoring, so the paths below
# (relative to this directory, core/xserver/build_common/) resolve correctly from
# either project root.
#
# Requires the parent to have already defined: wayland_protocols_dep.
# Exports: compositor_core_srcs, xbus_service_srcs, compositor_shader_files,
#          wayland_protocol_srcs.
#
# NOT unified (they legitimately differ per target and change rarely): the
# external dependency lists and the executable()/test() definitions — those live
# in each parent. Extra shaders (e.g. root's xkit UI shaders) are appended there.

# ── Wayland protocol generation ────────────────────────────────────────────────
wayland_scanner = find_program('wayland-scanner', required : true)
protocols_dir   = wayland_protocols_dep.get_variable(pkgconfig : 'pkgdatadir')

wayland_protocol_srcs = []
foreach p : [
  ['xdg-shell',
    protocols_dir + '/stable/xdg-shell/xdg-shell.xml'],
  ['linux-dmabuf-unstable-v1',
    protocols_dir + '/unstable/linux-dmabuf/linux-dmabuf-unstable-v1.xml'],
  ['wayland-drm',
    '../../wayland-bridge/protocols/wayland-drm.xml'],
  ['single-pixel-buffer-v1',
    protocols_dir + '/staging/single-pixel-buffer/single-pixel-buffer-v1.xml'],
  ['idle-inhibit-unstable-v1',
    protocols_dir + '/unstable/idle-inhibit/idle-inhibit-unstable-v1.xml'],
  ['xdg-dialog-v1',
    protocols_dir + '/staging/xdg-dialog/xdg-dialog-v1.xml'],
  ['fractional-scale-v1',
    protocols_dir + '/staging/fractional-scale/fractional-scale-v1.xml'],
  ['cursor-shape-v1',
    protocols_dir + '/staging/cursor-shape/cursor-shape-v1.xml'],
  ['text-input-unstable-v3',
    protocols_dir + '/unstable/text-input/text-input-unstable-v3.xml'],
  ['xdg-output-unstable-v1',
    protocols_dir + '/unstable/xdg-output/xdg-output-unstable-v1.xml'],
  ['relative-pointer-unstable-v1',
    protocols_dir + '/unstable/relative-pointer/relative-pointer-unstable-v1.xml'],
  ['pointer-constraints-unstable-v1',
    protocols_dir + '/unstable/pointer-constraints/pointer-constraints-unstable-v1.xml'],
  ['xdg-decoration-unstable-v1',
    protocols_dir + '/unstable/xdg-decoration/xdg-decoration-unstable-v1.xml'],
  ['presentation-time',
    protocols_dir + '/stable/presentation-time/presentation-time.xml'],
  ['viewporter',
    protocols_dir + '/stable/viewporter/viewporter.xml'],
  ['xdg-activation-v1',
    protocols_dir + '/staging/xdg-activation/xdg-activation-v1.xml'],
  ['wlr-layer-shell-unstable-v1',
    '../../wayland-bridge/protocols/wlr-layer-shell-unstable-v1.xml'],
  ['wlr-screencopy-unstable-v1',
    '../../wayland-bridge/protocols/wlr-screencopy-unstable-v1.xml'],
  ['tablet-unstable-v2',
    protocols_dir + '/unstable/tablet/tablet-unstable-v2.xml'],
  ['security-context-v1',
    protocols_dir + '/staging/security-context/security-context-v1.xml'],
  ['ext-idle-notify-v1',
    protocols_dir + '/staging/ext-idle-notify/ext-idle-notify-v1.xml'],
]
  wayland_protocol_srcs += custom_target(p[0] + '-header',
    input   : p[1],
    output  : p[0] + '-protocol.h',
    command : [wayland_scanner, 'server-header', '@INPUT@', '@OUTPUT@'],
  )
  wayland_protocol_srcs += custom_target(p[0] + '-code',
    input   : p[1],
    output  : p[0] + '-protocol.c',
    command : [wayland_scanner, 'private-code', '@INPUT@', '@OUTPUT@'],
  )
endforeach

# ── Compositor / xrender shaders (compiled to SPIR-V by each parent's glsl_gen) ─
# The compositor's own pipelines + the xrender pipeline shaders it renders
# through. (The root build appends the xkit UI shaders separately.)
compositor_shader_files = files(
  '../shaders/blit.vert',
  '../shaders/blit.frag',
  '../shaders/blur_h.frag',
  '../shaders/blur_v.frag',
  '../shaders/path.vert',
  '../shaders/path.frag',
  '../shaders/solid.vert',
  '../shaders/solid.frag',
  '../shaders/cursor.vert',
  '../shaders/cursor.frag',
  '../shaders/rounded.vert',
  '../shaders/rounded.frag',
  '../../../sdk/xrender/shaders/triangle.vert',
  '../../../sdk/xrender/shaders/triangle.frag',
  '../../../sdk/xrender/shaders/sdf_text.vert',
  '../../../sdk/xrender/shaders/sdf_text.frag',
  '../../../sdk/xrender/shaders/squircle.vert',
  '../../../sdk/xrender/shaders/squircle.frag',
)

# ── Compositor core (no XBus services; main.cc added at the executable call) ────
# Includes the xrender pipeline + wayland bridge the compositor compiles directly.
compositor_core_srcs = files(
  '../src/auth_throttle.cc',
  '../src/crash_handler.cc',
  '../src/drm_device.cc',
  '../src/cursor_glyphs.cc',
  '../src/event_loop.cc',
  '../src/seat_manager.cc',
  '../src/input_manager.cc',
  '../src/gamepad_manager.cc',
  '../src/vulkan_compositor.cc',
  '../src/window_decorator.cc',
  '../src/gpu_profiler.cc',
  '../src/ipc_socket.cc',
  '../src/xbus_message_pool.cc',
  '../src/udev_monitor.cc',
  # xrender compositor-only sources (not in libxrender)
  '../../../sdk/xrender/src/entity.cc',
  '../../../sdk/xrender/src/memory_allocator.cc',
  '../../../sdk/xrender/src/texture.cc',
  '../../../sdk/xrender/src/typography_backend.cc',
  '../../../sdk/xrender/src/vulkan_context.cc',
  # xrender app-facing sources (also in libxrender; recompiled for compositor)
  '../../../sdk/xrender/src/display_list.cc',
  '../../../sdk/xrender/src/font_atlas.cc',
  '../../../sdk/xrender/src/text_shaper.cc',
  '../../../sdk/xrender/src/font_manager.cc',
  '../../../sdk/xrender/src/image_decoder.cc',
  '../../../sdk/xrender/src/svg_engine.cc',
  # Wayland bridge
  '../../wayland-bridge/src/wayland_bridge.cc',
)

